{
  "name": "draglauncher",
  "version": "1.0.0",
  "description": "Minecraft launcher with Prism functionality and TLauncher account/skin system",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "build": "npm run build:vite && npm run build:electron",
    "start": "electron dist/main/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "tlauncher",
    "prism",
    "elyby"
  ],
  "author": "DragLauncher Team",
  "license": "GPL-3.0",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  },
  "build": {
    "appId": "org.draglauncher.app",
    "productName": "DragLauncher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  }
}
